# Copy this file to .env and fill in your own values.
# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Your database connection string (MySQL)
DATABASE_URL=

# Optional: set this to your own Supabase user ID (found in Supabase > Authentication > Users)
# to automatically grant that account the "admin" role.
OWNER_OPEN_ID=

# Leave as-is unless you know you need to change it.
NODE_ENV=development
